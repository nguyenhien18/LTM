<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="lan-exam-pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.ptit.lanexam.server.entity.Student</class>
        <class>com.ptit.lanexam.server.entity.Teacher</class>
        <class>com.ptit.lanexam.server.entity.Exam</class>
        <class>com.ptit.lanexam.server.entity.Question</class>
        <class>com.ptit.lanexam.server.entity.Subject</class>
        <class>com.ptit.lanexam.server.entity.BankQuestion</class>
        <class>com.ptit.lanexam.server.entity.Submission</class>
        <class>com.ptit.lanexam.server.entity.StudentAnswer</class>
        <class>com.ptit.lanexam.server.entity.ExamAttempt</class>
        <class>com.ptit.lanexam.server.entity.Assignment</class>
        <class>com.ptit.lanexam.server.entity.AssignmentSubmission</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/lan_exam?createDatabaseIfNotExist=true&amp;useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=Asia/Ho_Chi_Minh"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="root"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.jdbc.time_zone" value="Asia/Ho_Chi_Minh"/>
        </properties>
    </persistence-unit>
</persistence>
